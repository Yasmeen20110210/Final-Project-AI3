        "# Build a neural network using Keras Dense layers with ReLU and Sigmoid/Softmax\n",
        "early_stop = EarlyStopping(\n",
        "    monitor='val_loss',\n",
        "    patience=5, # Stop training if there is no improvement for 5 epochs\n",
        "    restore_best_weights=True\n",
        ")\n",
        "model = Sequential()\n",
        "# First hidden layer with 256 neurons and ReLU activation function\n",
        "# input_shape defines the number of input features\n",
        "model.add(Dense(256, activation='relu', input_shape=(x_train_scaled.shape[1],)))\n",
        "# Dropout layer to reduce overfitting\n",
        "model.add(Dropout(0.2))\n",
        "# Second hidden layer with 128 neurons\n",
        "model.add(Dense(128, activation='relu'))\n",
        "# 3rd hidden layer with 64 neurons\n",
        "model.add(Dense(64, activation='relu'))\n",
        "# Output layer using Softmax for multi-class classification\n",
        "model.add(Dense(num_classes, activation='softmax'))\n",
        "\n",
        "\n",
        "# Compile the model\n",
        "model.compile(\n",
        "    optimizer='adam',    # Adam optimizer updates the model weights efficiently\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
